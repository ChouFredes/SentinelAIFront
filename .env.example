# URL pública del FastAPI (solo hace falta con SENTINEL_USE_MOCKS=false)
SENTINEL_API_URL=
# Token admin en claro (32–512 caracteres)
SENTINEL_ADMIN_TOKEN=
# Contraseña de acceso al panel
PANEL_PASSWORD=
# Secreto para firmar la cookie de sesión (mínimo 32 caracteres)
SESSION_SECRET=
# true = el BFF responde con datos simulados de lib/api/mocks
SENTINEL_USE_MOCKS=true
